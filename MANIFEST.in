include CHANGELOG.md
include ASSET_LICENSE.md
include CONTRIBUTING.md
include LICENSE
include README.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
recursive-include docs *.md
recursive-include mcp *.py
recursive-include requirements *.in *.txt
